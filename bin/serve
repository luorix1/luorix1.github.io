#!/usr/bin/env bash
# Local dev: bind to all interfaces so localhost / 127.0.0.1 both reach LiveReload.
set -euo pipefail
cd "$(dirname "$0")/.."
exec bundle exec jekyll serve \
  --host 0.0.0.0 \
  --port 4000 \
  --force_polling \
  --livereload \
  --livereload-port "${LIVERELOAD_PORT:-35729}" \
  "$@"
